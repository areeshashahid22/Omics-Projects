ggplot(
top_10,
aes(
x = reorder(gene_id, log2FC),
y = log2FC
)
) +
geom_col(
fill = "#C65D7B",
width = 0.7
) +
coord_flip() +
labs(
title = "Top 10 Upregulated Genes",
x = "Gene",
y = "log2 Fold-Change (Treated vs Control)"
) +
theme_minimal(
base_size = 14
) +
theme(
plot.title = element_text(
face = "bold",
hjust = 0.5
),
axis.title = element_text(
face = "bold"
)
)
